# SpecTrace Backend Environment Variables Example
# Copy this file to .env and adjust values for local development.

# Application Configuration
ENVIRONMENT=development
PROJECT_NAME="SpecTrace API"
VERSION=0.1.0
API_V1_STR=/api/v1

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list for local frontend access)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Configuration
SECRET_KEY=your-secure-jwt-secret-key-min-32-chars-for-hs256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spectrace

# Connection Pool Tuning
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=True
